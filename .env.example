# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# Safe to expose to the browser: row-level security governs what they can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row-level security. Server-side only; never prefix with
# NEXT_PUBLIC_. Used by scheduled maintenance and by payment settlement, which
# is the trusted connection settle_payment() checks for.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap and share links.
# Leave blank on Vercel and it is derived from the deployment URL.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# SECRET, at least 16 characters. The expiry sweep at
# /api/cron/expire-advertisements only runs for a request carrying
# `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sends this automatically
# when the variable is set on the project.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Razorpay — Dashboard → Account & Settings → API Keys
# ---------------------------------------------------------------------------
# Payments are optional. Leave these blank and the site runs exactly as it
# does today: packages show no price, no checkout opens, and advertisements
# reach the office with nothing to collect.
#
# Use TEST keys in development. Razorpay issues them as rzp_test_… and live
# ones as rzp_live_…; the application reads the prefix and will say which mode
# it is in rather than leaving you to guess from a failed payment.

# Not secret — it identifies the account to the checkout, and the application
# returns it to the browser with the order it belongs to. It is NOT given a
# NEXT_PUBLIC_ prefix on purpose: a key inlined at build time has to be
# redeployed to rotate, and can drift out of step with the secret it is paired
# with.
RAZORPAY_KEY_ID=

# SECRET. Signs and verifies the checkout callback. Server-side only. If this
# ever reaches the browser, anybody can forge a "payment successful" callback.
RAZORPAY_KEY_SECRET=

# SECRET, and a DIFFERENT secret from the one above. Set in the Razorpay
# dashboard under Settings → Webhooks when you create the webhook pointing at
# https://your-domain/api/payments/webhook, subscribed to payment.captured,
# payment.failed and order.paid.
#
# Without it the webhook endpoint answers 503, so Razorpay keeps the event and
# retries once it is configured, rather than the delivery being lost quietly.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email — Resend (resend.com), or any provider with a compatible REST API
# ---------------------------------------------------------------------------
# Optional. Without these, notifications are still raised and the in-app
# notification centre still fills; the queued emails are recorded as `skipped`
# with a reason saying no provider is configured, rather than piling up as
# failures for somebody to investigate.
#
# The sending domain must be verified with the provider before anything is
# delivered. EMAIL_FROM takes either a bare address or `Name <address>`.
RESEND_API_KEY=
EMAIL_FROM=
# Where a reply goes — the office's own address, not the sending domain.
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# WhatsApp — Meta WhatsApp Business Cloud API
# ---------------------------------------------------------------------------
# Optional, and off by default for every advertiser: a message to somebody's
# telephone is not something to opt them into.
#
# IMPORTANT: a business-initiated WhatsApp message may only be an APPROVED
# TEMPLATE. Free text is permitted solely within 24 hours of the customer
# writing to you, which is never the case for these notifications. So a token
# without WHATSAPP_TEMPLATE_NAME can send nothing, and the application reports
# that plainly rather than collecting refusals from Meta.
#
# The template needs three body parameters, in this order:
#   {{1}} the advertiser's name
#   {{2}} the message
#   {{3}} a link back to this site
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Defaults to `en`. Must match the approved template's language exactly.
WHATSAPP_TEMPLATE_LANGUAGE=
# Defaults to v21.0.
WHATSAPP_API_VERSION=
