# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# Safe to expose to the browser: row-level security governs what they can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row-level security. Server-side only; never prefix with
# NEXT_PUBLIC_. Used by scheduled maintenance and payment webhooks (Phase 5).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap and share links.
# Leave blank on Vercel and it is derived from the deployment URL.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# SECRET, at least 16 characters. The expiry sweep at
# /api/cron/expire-advertisements only runs for a request carrying
# `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sends this automatically
# when the variable is set on the project.
CRON_SECRET=
